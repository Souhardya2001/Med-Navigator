# Supported first-version provider: openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
RAG_SERVICE_URL=http://rag-service:8000
HOSPITAL_SERVICE_URL=http://hospital-service:8000
# Paths are configurable because downstream services may expose different routes.
RAG_SEARCH_PATH=/search
HOSPITAL_NEARBY_PATH=/hospitals/nearby
RAG_SERVICE_TIMEOUT=10
HOSPITAL_SERVICE_TIMEOUT=10
LLM_TIMEOUT=30
APP_ENV=development
